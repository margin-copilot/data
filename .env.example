# Copy to .env and fill in. .env is gitignored. Account-specific values come from
# infra/scripts/fabric-env.sh (private infra repo) and from `riad-fabric setup`.
TENANT_ID=
# Public client app used by riad-fabric (sign in as the Fabric admin).
DATA_TOOLS_CLIENT_ID=
# Sign-in hint for the Fabric admin work account (optional).
FABRIC_ADMIN_UPN=
# Entra group whose members get workspace Viewer (CONNECT + ReadData on the SQL endpoint).
VIEWER_GROUP_ID=
# Domain of the test users' UPNs; with USER_REGIONS it builds rls.user_region at load time.
ENTRA_DOMAIN=
# alias:region, comma-separated; region N, C, S or * (all regions).
#USER_REGIONS=north.mgr:N,center.mgr:C,south.mgr:S,pricing.director:*
#FABRIC_WORKSPACE=margin-copilot
#FABRIC_LAKEHOUSE=riad
# Capacity display name. Default: the one active trial capacity.
#FABRIC_CAPACITY=
# Printed by `riad-fabric setup`.
WORKSPACE_ID=
LAKEHOUSE_ID=
SQL_ENDPOINT_ID=
SQL_ENDPOINT_HOST=
